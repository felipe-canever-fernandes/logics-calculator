?start	: expression

?expression	: operation

?operation	: binary
			| unary

?binary	: disjunction
		| conjunction
		| l_implication
		| j_implication
		| l_bi_implication

?unary	: weak_negation
		| strong_negation
		| distinction
		| crisp_truthness
		| parentheses
		| value

weak_negation	: "\\sim" unary
strong_negation	: "\\neg" unary
distinction		: "\\nabla" unary
crisp_truthness	: "\\Delta" unary
?parentheses	: "\\left(" expression "\\right)"
value			: NUMBER

disjunction			: expression "\\lor" unary
conjunction			: expression "\\land" unary
l_implication		: expression "\\rightarrow" unary
j_implication		: expression "\\roundimplies" unary
l_bi_implication	: expression "\\leftrightarrow" unary

%import common.NUMBER
%import common.WS

%ignore WS
