?start	: expression

?expression	: operation

?operation	: binary
			| unary

?binary	: disjunction
		| conjunction
		| l_implication
		| j_implication
		| l_bi_implication

?unary	: weak_negation
		| strong_negation
		| distinction
		| crisp_truthness
		| consistency
		| contradiction
		| parentheses
		| value

weak_negation	: "\\sim" unary
strong_negation	: "\\lnot" unary
distinction		: "\\nabla" unary
crisp_truthness	: "\\Delta" unary
consistency		: "o" unary
contradiction	: "\\sigma" unary
?parentheses	: "\\left(" expression "\\right)"
value			: NUMBER

disjunction			: expression "\\lor" unary
conjunction			: expression "\\land" unary
l_implication		: expression "\\xrightarrow[L]{}" unary
j_implication		: expression "\\xrightarrow[J]{}" unary
l_bi_implication	: expression "\\xleftrightarrow[L]{}" unary

%import common.NUMBER
%import common.WS

%ignore WS
