?start  : expression

?expression : operation

?operation  : binary
            | unary

?binary : disjunction
        | l_implication

?unary  : negation
        | distinction
        | value

negation        : "\\neg" unary
distinction     : "\\nabla" unary
disjunction     : expression "\\vee" unary
l_implication   : expression "\\rightarrow" unary

value   : NUMBER

%import common.NUMBER
%import common.WS

%ignore WS
