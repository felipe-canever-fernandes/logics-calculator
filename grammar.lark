?start	: expression
		| query

query	: expression "?"

?expression	: operation

?operation	: binary
			| unary

?binary	: weak_disjunction
		| bochvar_disjunction
		| quine_dagger
		| strong_disjunction
		| weak_conjunction
		| bochvar_conjunction
		| sheffer_stroke
		| strong_conjunction
		| l_implication
		| g_implication
		| j_implication
		| k_implication
		| bochvar_implication
		| r_implication
		| goguen_implication
		| l_equivalence
		| g_equivalence
		| j_equivalence
		| k_equivalence
		| bochvar_equivalence
		| r_equivalence
		| goguen_equivalence

?unary	: weak_negation
		| post_negation
		| strong_negation
		| mosil_nabla
		| baaz_delta
		| doubtful_operator
		| consistency
		| parentheses
		| variable
		| value

weak_negation		: "\\overline{" expression "}"
post_negation		: "!" expression
strong_negation		: "\\lnot" unary
mosil_nabla			: "\\nabla" unary
baaz_delta			: "\\Delta" unary
doubtful_operator	: "I" unary
consistency			: "\\circ" unary
?parentheses		: "\\left(" expression "\\right)"
variable			: VARIABLE
value				: VALUE

weak_disjunction	: expression "\\lor" unary
bochvar_disjunction	: expression "\\underset{+}{\\lor}" unary
quine_dagger		: expression "\\downarrow" unary
strong_disjunction	: expression "\\oplus" unary
weak_conjunction	: expression "\\land" unary
bochvar_conjunction	: expression "\\underset{+}{\\land}" unary
sheffer_stroke		: expression "\\uparrow" unary
strong_conjunction	: expression "\\otimes" unary
l_implication		: expression "\\xrightarrow[L]{}" unary
g_implication		: expression "\\xrightarrow[G]{}" unary
j_implication		: expression "\\xrightarrow[J]{}" unary
k_implication		: expression "\\xrightarrow[K]{}" unary
bochvar_implication	: expression "\\xrightarrow[+]{}" unary
r_implication		: expression "\\xrightarrow[R]{}" unary
goguen_implication	: expression "\\xrightarrow[\\pi]{}" unary
l_equivalence		: expression "\\xleftrightarrow[L]{}" unary
g_equivalence		: expression "\\xleftrightarrow[G]{}" unary
j_equivalence		: expression "\\xleftrightarrow[J]{}" unary
k_equivalence		: expression "\\xleftrightarrow[K]{}" unary
bochvar_equivalence	: expression "\\xleftrightarrow[+]{}" unary
r_equivalence		: expression "\\xleftrightarrow[R]{}" unary
goguen_equivalence	: expression "\\xleftrightarrow[\\pi]{}" unary

VARIABLE	: /[a-z]/

VALUE	: "0"
		| "\\frac12" | "\\frac{1}{2}"
		| "1"

%import common.WS

%ignore WS
