?start  : expression

?expression : operation

?operation  : binary
            | unary

?binary : disjunction

?unary  : negation
        | distinction
        | value

negation    : "\\neg" unary
distinction : "\\nabla" unary
disjunction : expression "\\vee" unary

value   : NUMBER

%import common.NUMBER
%import common.WS

%ignore WS
