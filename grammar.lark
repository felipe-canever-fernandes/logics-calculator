?start	: expression

?expression	: operation

?operation	: binary
			| unary

?binary	: disjunction
		| l_implication

?unary	: negation
		| distinction
		| parentheses
		| value

negation		: "\\neg" unary
distinction		: "\\nabla" unary
?parentheses	: "\\left(" expression "\\right)"
value			: NUMBER

disjunction		: expression "\\vee" unary
l_implication	: expression "\\rightarrow" unary

%import common.NUMBER
%import common.WS

%ignore WS
