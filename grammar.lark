start	: expression

?expression	: operation

?operation	: binary
			| unary

?binary	: disjunction
		| conjunction
		| implication

?unary	: negation
		| parentheses
		| variable
		| value

disjunction	: expression DISJUNCTION unary
conjunction	: expression CONJUNCTION unary
implication	: expression IMPLICATION unary

negation	: NEGATION unary
parentheses	: LEFT_PARENTHESIS expression RIGHT_PARENTHESIS
variable	: VARIABLE
value		: VALUE

DISJUNCTION			: "\\lor"
CONJUNCTION 		: "\\land"
IMPLICATION 		: "\\rightarrow"
NEGATION			: "\\sim"
LEFT_PARENTHESIS	: "\\left("
RIGHT_PARENTHESIS	: "\\right)"
VARIABLE			: "p"
VALUE				: "0"
					| "\\frac12" | "\\frac{1}{2}"
					| "1"

%import common.WS

%ignore WS
