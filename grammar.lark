?start	: expression
		| query

query	: expression "?"

?expression	: operation

?operation	: binary
			| unary

?binary	: disjunction
		| l_strong_disjunction
		| conjunction
		| l_strong_conjunction
		| g_implication
		| l_implication
		| j_implication
		| k_implication
		| g_bi_implication
		| l_bi_implication
		| j_bi_implication
		| k_bi_implication

?unary	: weak_negation
		| strong_negation
		| distinction
		| crisp_truthness
		| consistency
		| contradiction
		| parentheses
		| variable
		| value

weak_negation	: "\\sim" unary
strong_negation	: "\\lnot" unary
distinction		: "\\nabla" unary
crisp_truthness	: "\\Delta" unary
consistency		: "\\circ" unary
contradiction	: "\\sigma" unary
?parentheses	: "\\left(" expression "\\right)"
variable		: VARIABLE
value			: VALUE

disjunction				: expression "\\lor" unary
l_strong_disjunction	: expression "\\oplus" unary
conjunction				: expression "\\land" unary
l_strong_conjunction	: expression "\\otimes" unary
g_implication			: expression "\\xrightarrow[G]{}" unary
l_implication			: expression "\\xrightarrow[L]{}" unary
j_implication			: expression "\\xrightarrow[J]{}" unary
k_implication			: expression "\\xrightarrow[K]{}" unary
g_bi_implication		: expression "\\xleftrightarrow[G]{}" unary
l_bi_implication		: expression "\\xleftrightarrow[L]{}" unary
j_bi_implication		: expression "\\xleftrightarrow[J]{}" unary
k_bi_implication		: expression "\\xleftrightarrow[K]{}" unary

VARIABLE	: /[pq]/

VALUE	: "0"
		| "\\frac12" | "\\frac{1}{2}"
		| "1"

%import common.WS

%ignore WS
